<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>homepage</title>
    <style>
        table,
        th,
        td {
            border: 1px solid black;
        }
    </style>
</head>

<body>
    </H2>
    <br>


    <a href="/user/add">Add new user</a>



    <br>



    <br>
    <table>
        <tr>
            <th>Id</th>
            <th>username</th>
            <th>email</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
        <% for(user of result){%>
            <tr>
                <td>
                    <%=user.id%>
                </td>
                <td>
                    <%=user.username %>
                </td>
                <td>
                    <%=user.email %>
                </td>
                <td>
                    <form method="get" action="/user/<%=user.id%>/edit">
                        <button>edit</button>
                    </form>
                </td>

                <td>
                    <form method="get" action="/user/<%=user.id%>/delete">
                        <button>Delete</button>
                    </form>
                </td>




            </tr>
            <% }%>
    </table>
</body>

</html>