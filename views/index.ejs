<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Crud operation</title>
</head>

<body>
    <h1>Post Crud operation Data</h1>
    <% for(let post of arr){ %>
        <div class="post">
            <h3>
                @<%=post.username %>
            </h3>
            <h4>
                <%=post.comment %>
            </h4>
            <br>

            <a href="/posts/<%=post.id%>/edit">edit</a>
            <a href="/posts/<%=post.id%>/details">detais</a>
            <br>

            /posts/:id/delete
            <form method="POST" action="/posts/<%=post.id%>/delete?_method=DELETE"><button>delete</button></form>
        </div>



        <% } %>
            <a href="/new">Add new post</a>

</body>

</html>